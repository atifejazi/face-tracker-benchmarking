# Copy to config/paths.env and edit ROOTDIR for your machine.
# Load in shell:  set -a && source config/paths.env && set +a
#
# After sourcing, names like $MULTIREX_ROOT are bash variables.
# Type them with the $ as written and bash substitutes the path.
# Absolute paths are fine if clones/datasets are not under ROOTDIR.

export ROOTDIR="${ROOTDIR:-/path/to/workspace}"

# This repository
export REPO_ROOT="${REPO_ROOT:-$ROOTDIR/face-tracker-benchmarking}"

# Trackers and tools (clone separately; see SETUP.md)
export MICA_ROOT="${MICA_ROOT:-$ROOTDIR/other/MICA}"
export METRICAL_TRACKER_ROOT="${METRICAL_TRACKER_ROOT:-$ROOTDIR/other/metrical-tracker}"
export SMIRK_ROOT="${SMIRK_ROOT:-$ROOTDIR/other/smirk}"
export RVM_ROOT="${RVM_ROOT:-$ROOTDIR/other/RobustVideoMatting}"
export GA_ROOT="${GA_ROOT:-$ROOTDIR/GaussianAvatars}"
export VHAP_ROOT="${VHAP_ROOT:-$ROOTDIR/VHAP}"
export SYNCNET_ROOT="${SYNCNET_ROOT:-$ROOTDIR/syncnet_python}"

# Datasets (not in git)
export MULTIREX_ROOT="${MULTIREX_ROOT:-$ROOTDIR/data/multirex/ubisoft-laforge-multirex}"
export NOW_DATASET="${NOW_DATASET:-$ROOTDIR/data/now-dataset/dataset}"
export NERSSEMBLE_DATA="${NERSSEMBLE_DATA:-$ROOTDIR/data/nersemble_dset/SomeNeRSemble}"

# Run outputs (gitignored)
export RUNS_ROOT="${RUNS_ROOT:-$REPO_ROOT/runs}"
export MULTIREX_RESULTS="${MULTIREX_RESULTS:-$RUNS_ROOT/multirex_ranking_s8}"
export NOW_RESULTS="${NOW_RESULTS:-$RUNS_ROOT/now}"
export NERSSEMBLE_RUNS="${NERSSEMBLE_RUNS:-$RUNS_ROOT/nersemble}"
