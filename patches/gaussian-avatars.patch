+def _rodrigues_from_aa(aa: np.ndarray) -> np.ndarray:
+    """Convert 3D axis-angle vector to 3x3 rotation matrix (pure NumPy)."""
+    aa = np.asarray(aa, dtype=np.float64).reshape(3)
+    theta = float(np.linalg.norm(aa))
+    if theta < 1e-12:
+        return np.eye(3, dtype=np.float64)
+    k = aa / theta
+    K = np.array(
+        [
+            [0.0, -k[2], k[1]],
+            [k[2], 0.0, -k[0]],
+            [-k[1], k[0], 0.0],
+        ],
+        dtype=np.float64,
+    )
+    return np.eye(3, dtype=np.float64) + np.sin(theta) * K + (1.0 - np.cos(theta)) * (K @ K)
+
+
+def _compute_monocular_dynamic_extent(cam_info: list, mesh_infos: dict, min_radius: float = 0.05) -> float:
+    """Effective camera-to-head orbit radius when a monocular camera is affixed (fixed extrinsics)."""
+    if not cam_info or not mesh_infos:
+        return 0.1
+    W2C0 = getWorld2View2(cam_info[0].R, cam_info[0].T)
+    c_cam = np.linalg.inv(W2C0)[:3, 3].astype(np.float64)
+
+    # Use the same FLAME model and shaped joints as the mesh renderer.
+    from flame_model.flame import FlameHead
+    import torch
+    first = next(iter(mesh_infos.values()))
+    flame = FlameHead(np.asarray(first["shape"]).size, np.asarray(first["expr"]).size)
+    eff_centers = []
+    for m in mesh_infos.values():
+        rot_aa = np.asarray(m.get("rotation", np.zeros(3)), dtype=np.float64).reshape(3)
+        trans = np.asarray(m.get("translation", np.zeros(3)), dtype=np.float64).reshape(3)
+        R_rel = _rodrigues_from_aa(rot_aa)
+        beta = np.concatenate([np.asarray(m["shape"]).reshape(-1), np.asarray(m["expr"]).reshape(-1)])
+        with torch.no_grad():
+            shaped = flame.v_template + torch.einsum("d,vcd->vc", torch.tensor(beta, dtype=torch.float32), flame.shapedirs)
+            offset = np.asarray(m.get("static_offset", np.zeros((0, 3)))).reshape(-1, 3)
+            if len(offset) > len(shaped):
+                raise ValueError("static_offset has more vertices than FLAME")
+            shaped[:len(offset)] += torch.tensor(offset, dtype=torch.float32)
+            joint = (flame.J_regressor @ shaped)[0].numpy().astype(np.float64)
+        c_eff = R_rel.T @ (c_cam - trans - (np.eye(3) - R_rel) @ joint)
+        eff_centers.append(c_eff.reshape(3, 1))
+
+    if len(eff_centers) < 2:
+        return 0.1
+    pts = np.hstack(eff_centers)
+    center = np.mean(pts, axis=1, keepdims=True)
+    diagonal = float(np.max(np.linalg.norm(pts - center, axis=0)))
+    return max(diagonal * 1.1, min_radius)
+
